{
  "name": "fizisysmaker",
  "productName": "FiziSysMaker",
  "version": "1.0.0",
  "description": "A low-code platform to visually build data-driven web applications using technology you know and trust in minutes, 100% free, entirely yours.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "keywords": [
    "low-code",
    "database",
    "app-generator",
    "electron"
  ],
  "author": {
    "name": "Mohd Hafizi Mohammad Nor",
    "email": "mohdhafizi83@gmail.com"
  },
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "node-sql-parser": "^5.3.11"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@babel/preset-react": "^7.24.7",
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-webpack": "^7.4.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "electron": "25.0.0",
    "electron-rebuild": "^3.2.9",
    "style-loader": "^4.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "assets/icon",
        "asar": {
          "unpackDir": "bin"
        }
      },
      "rebuildConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "FiziSysMaker",
            "setupIcon": "assets/icon.ico"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-auto-unpack-natives",
          "config": {}
        },
        {
          "name": "@electron-forge/plugin-webpack",
          "config": {
            "mainConfig": "./webpack.main.config.js",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "html": "./src/renderer/index.html",
                  "js": "./src/renderer/js/renderer.js",
                  "name": "main_window",
                  "preload": {
                    "js": "./src/preload/preload.js"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
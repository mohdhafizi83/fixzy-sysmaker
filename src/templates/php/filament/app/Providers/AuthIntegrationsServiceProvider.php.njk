<?php

namespace App\Providers;

use Illuminate\Support\Facades\Route;
use Illuminate\Support\ServiceProvider;
{% if google %}
use App\Http\Controllers\Auth\GoogleController;
{% endif %}

/**
 * Auth integrations generated by Fixzy SysMaker.
 *
 * Registers SSO routes and applies runtime configuration from the
 * fixzy_settings table (admin-editable), so credentials never live
 * in committed files.
 */
class AuthIntegrationsServiceProvider extends ServiceProvider
{
    public function boot(): void
    {
        $this->registerRoutes();
        {% if google %}$this->applyGoogleConfig();{% endif %}
    }

    protected function registerRoutes(): void
    {
        if (! $this->app->runningInConsole()) {
            // Routes are registered lazily so the app boots even before
            // migrations run (e.g. during first-time setup).
            Route::middleware('web')->group(function (): void {
                {% if google %}Route::get('/auth/google', [GoogleController::class, 'redirect'])->name('auth.google');
                Route::get('/auth/google/callback', [GoogleController::class, 'callback'])->name('auth.google.callback');
                {% endif %}
            });
        }
    }

    {% if google %}
    protected function applyGoogleConfig(): void
    {
        // Guard: during migrate:fresh the settings table may not exist yet
        // while the app still boots (seeders). Skip silently in that window.
        try {
            if (! \Illuminate\Support\Facades\Schema::hasTable('fixzy_settings')) {
                return;
            }
        } catch (\Throwable) {
            return;
        }

        // Push admin-entered keys into Socialite's config at runtime.
        config([
            'services.google.client_id' => GoogleController::clientId(),
            'services.google.client_secret' => GoogleController::clientSecret(),
            'services.google.redirect' => GoogleController::redirectUri(),
        ]);
    }
    {% endif %}
}

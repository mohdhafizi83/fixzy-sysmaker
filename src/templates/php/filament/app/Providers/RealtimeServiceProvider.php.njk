{% raw %}<?php

namespace App\Providers;

use App\Models\FixzySetting;
use Filament\Facades\Filament;
use Illuminate\Support\Facades\Broadcast;
use Illuminate\Support\ServiceProvider;

/**
 * Real-time module generated by Fixzy SysMaker.
 *
 * Wires Laravel's NATIVE broadcasting to admin-entered settings so the
 * WebSocket transport (Reverb self-hosted, or Pusher hosted) can be
 * configured from the admin UI without redeploying:
 *
 *   - Broadcast connection + keys are read from fixzy_settings at boot
 *     (same pattern as the Mail/Telegram pages).
 *   - Private channel authorization: chat rooms and per-user notification
 *     channels require an authenticated user.
 *   - The Echo client (pusher-js + laravel-echo, pinned CDN scripts with
 *     SRI integrity) is injected into the panel via a render hook, so no
 *     npm build step is required in the generated app.
 */
class RealtimeServiceProvider extends ServiceProvider
{
    public function boot(): void
    {
        $this->applyBroadcastSettings();
        $this->registerChannels();
        $this->registerEchoClient();
    }

    protected function settingsAvailable(): bool
    {
        // Guard: during migrate:fresh the settings table may not exist
        // yet while the app still boots. Skip silently in that window.
        try {
            return \Illuminate\Support\Facades\Schema::hasTable('fixzy_settings');
        } catch (\Throwable) {
            return false;
        }
    }

    protected function applyBroadcastSettings(): void
    {
        if (! $this->settingsAvailable()) {
            return;
        }

        $backend = FixzySetting::get('realtime_backend', 'reverb');
        $backend = $backend === 'pusher' ? 'pusher' : 'reverb';

        // Both transports use Laravel's 'pusher' broadcast driver: Reverb
        // is protocol-compatible with the Pusher client — only host/port/
        // keys differ (laravel/reverb itself depends on pusher-php-server).
        // If the SDK is not installed yet (e.g. before the deploy step ran
        // composer require), fall back to 'log' so the app still boots —
        // broadcasting simply no-ops.
        $pusherInstalled = class_exists(\Pusher\Pusher::class);
        if (! $pusherInstalled) {
            config(['broadcasting.default' => 'log']);
            return;
        }

        config(['broadcasting.default' => 'pusher']);

        // Define the connection fully here so the app does not depend on a
        // published config/broadcasting.php file.
        $isReverb = $backend === 'reverb';

        config([
            'broadcasting.connections.pusher.driver' => 'pusher',
            'broadcasting.connections.pusher.key' => FixzySetting::get('broadcast_key', ''),
            'broadcasting.connections.pusher.secret' => FixzySetting::get('broadcast_secret', ''),
            'broadcasting.connections.pusher.app_id' => FixzySetting::get('broadcast_app_id', ''),
            'broadcasting.connections.pusher.options.host' => FixzySetting::get('broadcast_host', $isReverb ? 'localhost' : 'api.pusherapp.com'),
            'broadcasting.connections.pusher.options.port' => (int) FixzySetting::get('broadcast_port', $isReverb ? '8080' : '443'),
            'broadcasting.connections.pusher.options.scheme' => FixzySetting::get('broadcast_scheme', $isReverb ? 'http' : 'https'),
            'broadcasting.connections.pusher.options.encrypted' => true,
        ]);

        // Reverb server-side: `php artisan reverb:start` boots this app too,
        // so the same admin-entered credentials can feed the server config
        // (config/reverb.php reads REVERB_* env by default). Keeps the
        // whole flow plug-and-play without editing .env.
        if ($isReverb && config()->has('reverb.apps.apps')) {
            $apps = config('reverb.apps.apps');
            if (is_array($apps) && array_key_exists(0, $apps)) {
                $apps[0]['id'] = FixzySetting::get('broadcast_app_id', $apps[0]['id'] ?? 'fixzy-app');
                $apps[0]['key'] = FixzySetting::get('broadcast_key', $apps[0]['key'] ?? '');
                $apps[0]['secret'] = FixzySetting::get('broadcast_secret', $apps[0]['secret'] ?? '');
                config(['reverb.apps.apps' => $apps]);
            }
        }
    }

    protected function registerChannels(): void
    {
        // Chat rooms: any authenticated user may join a room.
        Broadcast::channel('chat.*', fn ($user): bool => $user !== null);

        // Per-user notification channel used by Filament's database
        // notifications broadcast (App.User.{id}).
        Broadcast::channel('App.User.*', fn ($user, $id): bool => (int) $user->getAuthIdentifier() === (int) $id);
        Broadcast::channel('Illuminate.Notifications.*', fn ($user, $id): bool => (int) $user->getAuthIdentifier() === (int) $id);
    }

    protected function registerEchoClient(): void
    {
        // Lazy: the JS (and its settings reads) is only built when the panel
        // actually renders — never during boot/migrate, when the settings
        // table may not exist yet.
        Filament::registerRenderHook(
            'panels::scripts.before',
            fn (): string => $this->echoInitScript(),
        );
    }

    protected function echoInitScript(): string
    {
        if (! $this->settingsAvailable()) {
            return '';
        }

        $config = [
            'broadcaster' => 'pusher',
            'key' => (string) (FixzySetting::get('broadcast_key') ?? ''),
            'wsHost' => (string) (FixzySetting::get('broadcast_host') ?? 'localhost'),
            'wsPort' => (int) (FixzySetting::get('broadcast_port') ?? 8080),
            'wssPort' => (int) (FixzySetting::get('broadcast_wss_port') ?? 443),
            'forceTLS' => filter_var(FixzySetting::get('broadcast_force_tls', '0'), FILTER_VALIDATE_BOOLEAN),
            'enabledTransports' => ['ws', 'wss'],
            'encrypted' => true,
        ];

        $json = json_encode($config);

        // Pinned, SRI-verified CDN builds (no npm build needed in the
        // generated app). Versions match the manifest npm entries.
        $pusherTag = '<script src="https://cdn.jsdelivr.net/npm/pusher-js@8.6.0/dist/web/pusher.min.js" integrity="sha384-yz6oLe92Sren05O3WPhu8DK05E9PEkh7kTQJ819acmwKwcCMwJXGu9Kta5wYhfaJ" crossorigin="anonymous"></script>';
        $echoTag = '<script src="https://cdn.jsdelivr.net/npm/laravel-echo@2.5.0/dist/echo.iife.js" integrity="sha384-Kq9euGu5WTcvbilq3ziOV6gkliaI5dp7hOs78B8gl6HYlBeerOZlIaE9KfALmAs0" crossorigin="anonymous"></script>';

        $boot = '<script>' . "\n"
            . '    window.Pusher = window.Pusher || Pusher;' . "\n"
            . '    window.Echo = new Echo(' . $json . ');' . "\n"
            . "    window.dispatchEvent(new CustomEvent('EchoLoaded'));" . "\n"
            . '</script>';

        return $pusherTag . "\n" . $echoTag . "\n" . $boot;
    }
}
{% endraw %}

<?php

namespace App\Filament\Pages;

use App\Models\FixzySetting;
use Filament\Pages\Page;

/**
 * Mail settings (Fixzy SysMaker generated).
 *
 * The admin configures the SMTP server here once. Values are stored in
 * the fixzy_settings table and applied to Laravel's mail config at boot,
 * so workflow "Send Email" actions work without touching .env or
 * redeploying. If left empty, the app falls back to .env / default mailer.
 */
class MailSettings extends Page
{
    protected static string | \BackedEnum | null $navigationIcon = 'heroicon-o-envelope';

    protected static ?string $navigationLabel = 'Mail Settings';

    protected static ?string $title = 'Outgoing Mail (SMTP) Settings';

    protected static ?string $slug = 'mail-settings';

    protected string $view = 'filament.pages.mail-settings';

    protected static ?int $navigationSort = 997;

    protected static string | \UnitEnum | null $navigationGroup = 'System';

    public array $settings = [];

    /**
     * Load saved SMTP settings into the form.
     */
    public function mount(): void
    {
        $this->settings = [
            'mail_host' => FixzySetting::get('mail_host', ''),
            'mail_port' => FixzySetting::get('mail_port', '587'),
            'mail_username' => FixzySetting::get('mail_username', ''),
            'mail_password' => FixzySetting::get('mail_password', ''),
            'mail_encryption' => FixzySetting::get('mail_encryption', 'tls'),
            'mail_from_address' => FixzySetting::get('mail_from_address', ''),
            'mail_from_name' => FixzySetting::get('mail_from_name', config('app.name')),
        ];
    }

    /**
     * Persist every non-empty mail setting via FixzySetting.
     */
    public function save(): void
    {
        $allowed = array_keys($this->settings);

        foreach ($allowed as $key) {
            $value = $this->settings[$key] ?? null;
            if ($value !== null && $value !== '') {
                FixzySetting::set($key, $value);
            }
        }

        session()->flash('fixzy_settings_saved', 'Mail settings saved. Workflow emails now use this SMTP server.');
    }

    /**
     * Send a test email through the configured SMTP server to verify settings.
     */
    public function testSend(): void
    {
        $to = $this->settings['mail_from_address'] ?? '';
        if ($to === '') {
            session()->flash('fixzy_settings_error', 'Set a "From address" first — the test email is sent there.');
            return;
        }

        try {
            \Illuminate\Support\Facades\Mail::raw(
                'This is a test message from your Fixzy SysMaker generated app. If you received it, your SMTP settings work.',
                function ($msg) use ($to) {
                    $msg->to($to);
                    $msg->subject('[Fixzy] Mail connection test');
                }
            );
            session()->flash('fixzy_settings_saved', "Test email sent to {$to}. Check your inbox (and spam).");
        } catch (\Throwable $e) {
            session()->flash('fixzy_settings_error', 'Send failed: ' . $e->getMessage());
        }
    }
}

<?php

namespace App\Filament\Auth;

use Filament\Auth\Http\Responses\Contracts\LoginResponse;
use Filament\Auth\Pages\Login;
use Filament\Forms\Components\TextInput;
use Filament\Notifications\Notification;
use Filament\Schemas\Schema;
use Illuminate\Validation\ValidationException;

/**
 * Combined login page generated by Fixzy SysMaker.
 *
 * Includes only the features enabled in the project settings:
 *   - captcha: built-in arithmetic human check (no third-party service)
 *   - LDAP:    directory authentication via App\Services\LdapAuthenticator
 *   - Google SSO button (handled by routes; shown via panel render hook)
 */
class FixzyLogin extends Login
{
    /**
     * Login form; adds the captcha human-check component when captcha is enabled.
     *
     * @param  Schema  $schema  The login form schema.
     * @return  Schema  The composed login form schema.
     */
    public function form(Schema $schema): Schema
    {
        $components = [
            $this->getEmailFormComponent(),
            $this->getPasswordFormComponent(),
            $this->getRememberFormComponent(),
        ];

        {% if captcha %}
        $captcha = session()->get('fixzy_captcha');
        if (!is_array($captcha) || count($captcha) !== 2) {
            $captcha = [random_int(1, 9), random_int(1, 9)];
            session(['fixzy_captcha' => $captcha]);
        }

        $components[] = TextInput::make('captcha')
            ->label("Human check: what is {$captcha[0]} + {$captcha[1]}?")
            ->numeric()
            ->required()
            ->rule(function (string $attribute, $value): bool {
                $c = session('fixzy_captcha');
                return is_array($c) && (int) $value === ((int) $c[0] + (int) $c[1]);
            }, 'Incorrect answer — please try again.');
        {% endif %}

        {% if recaptcha %}
        // Google reCAPTCHA v2: the visible "I'm not a robot" widget is
        // rendered by the panel render hook (fixzy-recaptcha-widget view).
        // Its callback pushes the token into this field's Livewire state,
        // and the token is verified server-side here.
        $components[] = \Filament\Forms\Components\Hidden::make('g-recaptcha-response')
            ->required()
            ->rule(function (string $attribute, $value): bool {
                return \App\Services\RecaptchaService::verify(
                    $value ? (string) $value : null,
                    request()->ip()
                );
            }, 'Human verification failed — please complete the reCAPTCHA and try again.');
        {% endif %}

        return $schema->components($components);
    }

    {% if ldap %}
    /**
     * LDAP usernames are not always email addresses, so relax the email
     * format rule and label the field accordingly.
     */
    protected function getEmailFormComponent(): \Filament\Schemas\Components\Component
    {
        return TextInput::make('email')
            ->label('Username or email')
            ->required()
            ->autocomplete()
            ->autofocus()
            ->extraInputAttributes(['tabindex' => 1]);
    }

    /**
     * Authenticate locally first; on failure fall back to the LDAP directory before giving up.
     * @return  ?LoginResponse  Login response on success, null when no redirect is returned.
     */
    public function authenticate(): ?LoginResponse
    {
        // getState() runs ALL form validation first — including the
        // captcha rule when enabled — so the LDAP fallback below can
        // never be reached with a failed human check.
        $data = $this->form->getState();

        try {
            return parent::authenticate();
        } catch (ValidationException $localFailure) {
            // Local auth failed — try the directory before giving up.
            $authenticator = app(\App\Services\LdapAuthenticator::class);

            try {
                $user = $authenticator->attempt(
                    (string) ($data['email'] ?? ''),
                    (string) ($data['password'] ?? '')
                );
            } catch (\RuntimeException $serverError) {
                Notification::make()
                    ->title('Directory sign-in problem')
                    ->body($serverError->getMessage())
                    ->danger()
                    ->send();

                return null;
            }

            if (! $user) {
                throw $localFailure;
            }

            \Filament\Facades\Filament::auth()->login($user, (bool) ($data['remember'] ?? false));
            session()->regenerate();

            return app(LoginResponse::class);
        }
    }
    {% endif %}
}

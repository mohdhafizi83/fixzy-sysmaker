<?php

namespace App\Filament\Imports;

use App\Models\{{ model_name }};
{% for rel_use in relationship_uses %}{{ rel_use }}
{% endfor %}{% if relationship_uses.length == 0 %}
{% endif %}use Filament\Actions\Imports\ImportColumn;
use Filament\Actions\Imports\Importer;
use Filament\Actions\Imports\Models\Import;
use Illuminate\Support\Number;
use Filament\Forms\Components\Checkbox;

class {{ model_name }}Importer extends Importer
{
    protected static ?string $model = {{ model_name }}::class;
{% if import_profile %}
    /**
     * Smart-import profile baked at generation time (Fixzy SysMaker).
     * match_field: column used to locate an existing row.
     * mode: update (match→update, else insert) | skip (match→skip,
     * else insert) | insert (always insert).
     */
    protected static ?array $profile = {{ import_profile }};
{% endif %}
    public static function getColumns(): array
    {
        return [
{% for col in columns %}            ImportColumn::make('{{ col.name }}')
                ->label('{{ col.label }}')
{% if col.required_mapping %}                ->requiredMapping()
{% endif %}{% if col.relationship %}                ->relationship(resolveUsing: ['{{ col.relationship }}'])
{% endif %}{% if col.numeric %}                ->numeric()
{% endif %}{% if col.integer %}                ->integer()
{% endif %}{% if col.boolean %}                ->boolean()
{% endif %}{% if col.json_list %}                ->multiple(',')
{% endif %}{% if col.helper_text %}                ->helperText('{{ col.helper_text }}')
{% endif %}                ->ignoreBlankState()
{% if col.rules %}                ->rules([{{ col.rules }}])
{% endif %}                ->examples([{{ col.examples }}])
                ->exampleHeader('{{ col.label }}'),
{% if not loop.last %}
{% endif %}{% endfor %}        ];
    }
{% if import_profile %}
    public function resolveRecord(): ?{{ model_name }}
    {
        $mode = static::$profile['mode'] ?? 'update';

        if ($mode === 'insert') {
            return new {{ model_name }}();
        }

        $matchField = static::$profile['match_field'] ?? '';
        $value = $this->data[$matchField] ?? null;

        if ($matchField === '' || $value === null || $value === '') {
            // No usable match value → always insert.
            return new {{ model_name }}();
        }

        $existing = {{ model_name }}::where($matchField, $value)->first();

        if (! $existing) {
            return new {{ model_name }}();
        }

        if ($mode === 'skip') {
            // Match found but profile says skip → return null so the
            // row is not processed further.
            return null;
        }

        // mode === 'update'
        return $existing;
    }

    public function saveRecord(): void
    {
        // Dry-run: validation already ran upstream; skip persistence.
        if (! empty($this->options['dry_run'])) {
            return;
        }

        parent::saveRecord();
    }
{% else %}
    public function resolveRecord(): ?{{ model_name }}
    {
{{ resolve_logic }}
    }
{% endif %}
    public static function getCompletedNotificationBody(Import $import): string
    {
{% if import_profile %}        $dryRun = ! empty($import->options['dry_run']);
        $verb = $dryRun ? 'validated' : 'imported';
        $body = 'Your {{ frase_model_name }} import has completed and ' . Number::format($import->successful_rows) . ' ' . str('row')->plural($import->successful_rows) . ' ' . $verb . '.';
{% else %}        $body = 'Your {{ frase_model_name }} import has completed and ' . Number::format($import->successful_rows) . ' ' . str('row')->plural($import->successful_rows) . ' imported.';
{% endif %}
        if ($failedRowsCount = $import->getFailedRowsCount()) {
            $body .= ' ' . Number::format($failedRowsCount) . ' ' . str('row')->plural($failedRowsCount) . ' failed to import.';
        }

        return $body;
    }
    
    public static function getOptionsFormComponents(): array
    {
        return [
{% if import_profile %}            Checkbox::make('dry_run')
                ->label('Dry run (validate only, nothing is saved)')
                ->default({{ import_dry_run_default }}),
{% else %}            Checkbox::make('updateExisting')
                ->label('Update existing records'),
{% endif %}        ];
    }

}

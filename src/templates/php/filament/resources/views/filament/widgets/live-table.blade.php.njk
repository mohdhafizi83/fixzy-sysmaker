{% raw %}{{-- Live table widget: renders the standard Filament table widget with one of
     two refresh strategies chosen by the widget's refreshMode():
     'poll'  -> hidden wire:poll driver (no native CanPoll on TableWidget)
     'live'  -> Echo websocket subscription (script below) --}}
@include('filament-widgets::table-widget')

@if ($this->refreshMode() === 'poll')
    {{-- TableWidget has no native CanPoll; this hidden driver ticks the refresh. --}}
    <div wire:poll.{{ $this->pollIntervalString() }} style="display:none"></div>
@endif

@script
    <script>
        {{-- Live mode only: listen on fixzy.data.<table> for the
             .fixzy.data.changed broadcast and $refresh the table.
             Tolerates Echo loading after this script (EchoLoaded event). --}}
        (() => {
            if (@js($this->refreshMode()) !== 'live') return;
            const table = @js($this->getLiveTable());
            if (!table) return;
            const subscribe = () => {
                window.Echo.private('fixzy.data.' + table).listen('.fixzy.data.changed', () => {
                    $wire.$refresh();
                });
            };
            window.addEventListener('EchoLoaded', () => subscribe());
            if (window.Echo) subscribe();
        })();
    </script>
@endscript
{% endraw %}

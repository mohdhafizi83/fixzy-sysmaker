{% raw %}<x-filament-panels::page>
    {{-- Server status: read-only health overview generated by Fixzy SysMaker.
         PHP runtime, required extensions, app environment, disk/memory
         headroom and queue backlog. No sensitive values are shown. --}}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">

        <x-filament::section>
            <x-slot name="heading">
                <span style="font-size: 0.875rem; font-weight: 600;">PHP runtime</span>
            </x-slot>
            <table style="width: 100%; font-size: 0.8125rem; border-collapse: collapse;">
                @foreach ([
                    'Version' => $php['version'],
                    'Memory limit' => $php['memory_limit'],
                    'Upload max' => $php['upload_max_filesize'],
                    'Post max' => $php['post_max_size'],
                    'Max execution' => $php['max_execution_time'] . 's',
                ] as $label => $value)
                    <tr style="border-bottom: 1px solid rgb(243 244 246);">
                        <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">{{ $label }}</td>
                        <td style="padding: 0.4rem 0; font-weight: 500;">{{ $value }}</td>
                    </tr>
                @endforeach
                <tr>
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">OPcache</td>
                    <td style="padding: 0.4rem 0;">
                        <x-filament::badge :color="$php['opcache'] ? 'success' : 'warning'">
                            {{ $php['opcache'] ? 'Enabled' : 'Disabled' }}
                        </x-filament::badge>
                    </td>
                </tr>
            </table>
        </x-filament::section>

        <x-filament::section>
            <x-slot name="heading">
                <span style="font-size: 0.875rem; font-weight: 600;">Required extensions</span>
            </x-slot>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                @foreach ($extensions as $ext => $loaded)
                    <x-filament::badge :color="$loaded ? 'success' : 'danger'">
                        {{ $ext }}{{ $loaded ? '' : ' missing' }}
                    </x-filament::badge>
                @endforeach
            </div>
        </x-filament::section>

        <x-filament::section>
            <x-slot name="heading">
                <span style="font-size: 0.875rem; font-weight: 600;">Application</span>
            </x-slot>
            <table style="width: 100%; font-size: 0.8125rem; border-collapse: collapse;">
                @foreach ([
                    'Laravel' => $app['laravel_version'],
                    'Environment' => $app['environment'],
                    'Timezone' => $app['timezone'],
                    'Server time' => $app['server_time'],
                ] as $label => $value)
                    <tr style="border-bottom: 1px solid rgb(243 244 246);">
                        <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">{{ $label }}</td>
                        <td style="padding: 0.4rem 0; font-weight: 500;">{{ $value }}</td>
                    </tr>
                @endforeach
                <tr>
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">Debug mode</td>
                    <td style="padding: 0.4rem 0;">
                        <x-filament::badge :color="$app['debug'] ? 'warning' : 'success'">
                            {{ $app['debug'] ? 'ON (disable in production)' : 'Off' }}
                        </x-filament::badge>
                    </td>
                </tr>
            </table>
        </x-filament::section>

        <x-filament::section>
            <x-slot name="heading">
                <span style="font-size: 0.875rem; font-weight: 600;">Resources</span>
            </x-slot>
            <table style="width: 100%; font-size: 0.8125rem; border-collapse: collapse;">
                <tr style="border-bottom: 1px solid rgb(243 244 246);">
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">Disk free</td>
                    <td style="padding: 0.4rem 0; font-weight: 500;">{{ $disk['free'] }} of {{ $disk['total'] }}</td>
                </tr>
                <tr style="border-bottom: 1px solid rgb(243 244 246);">
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">Disk used</td>
                    <td style="padding: 0.4rem 0; font-weight: 500;">{{ $disk['used_percent'] === null ? 'n/a' : $disk['used_percent'] . '%' }}</td>
                </tr>
                <tr style="border-bottom: 1px solid rgb(243 244 246);">
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">Memory (current)</td>
                    <td style="padding: 0.4rem 0; font-weight: 500;">{{ $memory['current'] }}</td>
                </tr>
                <tr>
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">Memory (peak)</td>
                    <td style="padding: 0.4rem 0; font-weight: 500;">{{ $memory['peak'] }}</td>
                </tr>
            </table>
        </x-filament::section>

        <x-filament::section>
            <x-slot name="heading">
                <span style="font-size: 0.875rem; font-weight: 600;">Queue</span>
            </x-slot>
            <table style="width: 100%; font-size: 0.8125rem; border-collapse: collapse;">
                <tr style="border-bottom: 1px solid rgb(243 244 246);">
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">Driver</td>
                    <td style="padding: 0.4rem 0; font-weight: 500;">{{ $queue['driver'] }}</td>
                </tr>
                <tr style="border-bottom: 1px solid rgb(243 244 246);">
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">Pending jobs</td>
                    <td style="padding: 0.4rem 0; font-weight: 500;">{{ $queue['pending'] ?? 'n/a' }}</td>
                </tr>
                <tr>
                    <td style="padding: 0.4rem 1rem 0.4rem 0; color: rgb(107 114 128);">Failed jobs</td>
                    <td style="padding: 0.4rem 0;">
                        @if (($queue['failed'] ?? null) === null)
                            <span style="font-weight: 500;">n/a</span>
                        @elseif ($queue['failed'] > 0)
                            <x-filament::badge color="danger">{{ $queue['failed'] }}</x-filament::badge>
                        @else
                            <x-filament::badge color="success">0</x-filament::badge>
                        @endif
                    </td>
                </tr>
            </table>
        </x-filament::section>

    </div>

    <p style="margin-top: 1rem; font-size: 0.75rem; color: rgb(156 163 175);">
        Read-only overview. Values refresh on page load. Generated by Fixzy SysMaker.
    </p>
</x-filament-panels::page>{% endraw %}

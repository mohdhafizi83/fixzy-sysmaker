{% raw %}<x-filament-panels::page>
    @if(session('fixzy_settings_saved'))
        <div class="rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm dark:bg-green-950 dark:text-green-200 dark:border-green-800">
            {{ session('fixzy_settings_saved') }}
        </div>
    @endif
    @if(session('fixzy_settings_error'))
        <div class="rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm dark:bg-red-950 dark:text-red-200 dark:border-red-800">
            {{ session('fixzy_settings_error') }}
        </div>
    @endif

    <form wire:submit="save" class="space-y-6">
        <x-filament::section heading="Broadcast Backend">
            <p class="text-sm text-gray-500 mb-4">
                Choose how real-time events reach browsers. <strong>Reverb</strong> runs on your own server
                (<code>php artisan reverb:start</code>) — generate any app ID / key / secret you like and use
                the same values in <code>.env</code> for the Reverb server. <strong>Pusher</strong> uses
                credentials from your <a href="https://dashboard.pusher.com" target="_blank" class="text-primary-600 underline">Pusher dashboard</a>.
            </p>
            <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                    <span class="text-sm font-medium">Backend</span>
                    <select wire:model="settings.realtime_backend"
                          class="mt-1 w-full rounded-lg border-gray-300 shadow-sm dark:bg-gray-800 dark:border-gray-600 px-3 py-2 text-sm">
                        <option value="reverb">Laravel Reverb (self-hosted)</option>
                        <option value="pusher">Pusher Channels (hosted)</option>
                    </select>
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Scheme</span>
                    <select wire:model="settings.broadcast_scheme"
                          class="mt-1 w-full rounded-lg border-gray-300 shadow-sm dark:bg-gray-800 dark:border-gray-600 px-3 py-2 text-sm">
                        <option value="http">http (local / behind proxy TLS)</option>
                        <option value="https">https (wss)</option>
                    </select>
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Host</span>
                    <input type="text" wire:model="settings.broadcast_host" placeholder="localhost (Reverb) / api.pusherapp.com (Pusher)"
                           class="mt-1 w-full rounded-lg border-gray-300 shadow-sm dark:bg-gray-800 dark:border-gray-600 px-3 py-2 text-sm" />
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Port</span>
                    <input type="text" wire:model="settings.broadcast_port" placeholder="8080 (Reverb) / 443 (Pusher)"
                           class="mt-1 w-full rounded-lg border-gray-300 shadow-sm dark:bg-gray-800 dark:border-gray-600 px-3 py-2 text-sm" />
                </label>
                <label class="block">
                    <span class="text-sm font-medium">App ID</span>
                    <input type="text" wire:model="settings.broadcast_app_id"
                           class="mt-1 w-full rounded-lg border-gray-300 shadow-sm dark:bg-gray-800 dark:border-gray-600 px-3 py-2 text-sm" />
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Key</span>
                    <input type="text" wire:model="settings.broadcast_key"
                           class="mt-1 w-full rounded-lg border-gray-300 shadow-sm dark:bg-gray-800 dark:border-gray-600 px-3 py-2 text-sm" />
                </label>
                <label class="block md:col-span-2">
                    <span class="text-sm font-medium">Secret</span>
                    <input type="password" wire:model="settings.broadcast_secret"
                           class="mt-1 w-full rounded-lg border-gray-300 shadow-sm dark:bg-gray-800 dark:border-gray-600 px-3 py-2 text-sm" />
                </label>
            </div>
            <p class="text-xs text-gray-400 mt-3">
                For Reverb, set the matching <code>REVERB_APP_ID</code>, <code>REVERB_APP_KEY</code>,
                <code>REVERB_APP_SECRET</code> in <code>.env</code> so the server validates the same credentials.
            </p>
        </x-filament::section>

        <div class="flex justify-end gap-3">
            <x-filament::button type="submit">Save settings</x-filament::button>
        </div>
    </form>
</x-filament-panels::page>
{% endraw %}
